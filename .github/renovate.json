{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>daflyinbed/renovate-config"],
  "ignoreDeps": ["postgres"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "RustFS image in the local k3s manifest generated by `just gen-rustfs`",
      "managerFilePatterns": ["/^justfile$/"],
      "matchStrings": [
        "image: (?<depName>rustfs/rustfs):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "pinDigests": true
    }
  ]
}
