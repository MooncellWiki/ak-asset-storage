{
  "db_name": "PostgreSQL",
  "query": "SELECT e.path, r.file_path FROM launcher_entries e JOIN launcher_releases r ON r.id = e.release_id\n            WHERE e.md5 = $1 AND e.size = $2\n            GROUP BY e.path, r.file_path\n            ORDER BY max(launcher_version_key(r.package_version)) DESC, max(r.id) DESC, e.path, r.file_path",
