{
  "db_name": "PostgreSQL",
  "query": "SELECT e.path, e.md5, e.size, b.sha256, b.attempts, b.last_error,\n            b.sha256 IS NULL AND b.retry_at = 'infinity' AS \"retries_exhausted!\"\n            FROM launcher_entries e JOIN launcher_blobs b USING (md5, size)\n            WHERE e.release_id = $1 AND e.path > $2 AND strpos(e.path, $3) > 0 ORDER BY e.path LIMIT $4",
