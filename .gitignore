# Local dev environment: tracked files are the committed setup (see tmp/README.md);
# everything else under tmp/ (S3 data, assets, plocate index) stays local.
tmp/*
!tmp/config.toml
!tmp/docker-compose.override.yaml
!tmp/README.md
e2e/runtime/

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# include cargo lock
# !Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

*.sqlite

.DS_Store
.vite-ssg-dist
.vite-ssg-temp
*.local
.env
dist
dist-ssr
node_modules
.idea/
*.log

components.d.ts

.zcode
